# systemd service for the Recipe Box API (app/server.py).
#
#   sudo cp deploy/recipes-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now recipes-api
#   systemctl status recipes-api

[Unit]
Description=Recipe Box API
After=network.target mysql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/recipes/app
ExecStart=/usr/bin/python3 /var/www/recipes/app/server.py
Restart=on-failure
RestartSec=2

# The API only needs to read its own files and reach MySQL.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
